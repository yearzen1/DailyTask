{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DailyTask",
  "version": "0.1.14",
  "identifier": "com.dailytask.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DailyTask",
        "width": 1080,
        "height": 720,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyQzJFNUJCMzE4NzQ1MjQKUldRa1JZY3h1K1hDQW9OYjNvdzBuUDMrMjRrOGl4dk9LaWExRUV6R2szTzZOQjJTVTJ2bXVtbWQK",
      "endpoints": [
        "https://github.com/yearzen1/DailyTask/releases/latest/download/latest.json"
      ]
    }
  }
}
